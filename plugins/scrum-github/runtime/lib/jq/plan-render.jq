# Markdown view of a plan (design 9). Pure: same input, same output.
# Input: a valid plan in version 2 form. --argjson cfg CONFIG --argjson milestones [...] (may be [])
# Output (use -r): the text of plan.md.
include "scrum";
include "plan";

# Numbers without a trailing ".0"; at most two decimals.
def num: if . == floor then tostring else ((. * 100 | round) / 100 | tostring) end;
def cell: tostring | gsub("\\|"; "\\|") | gsub("\n"; " ");
def pts($p): if $p == null then "–" else ($p | tostring) end;
def issue_ref: if .issue == null then "–" else "#\(.issue)" end;
def sprint_text: if . == null or . == "" then "backlog (no sprint)" elif (ascii_downcase) == "current" then "current sprint" else . end;
def plural($n; $one; $many): "\($n) \(if $n == 1 then $one else $many end)";

. as $plan
| $cfg.planning.hours_per_point as $hpp
| def hours($p): if $hpp == null or $p == null then null else $p * $hpp end;
  def total($ts): [$ts[] | .points // empty] | add // 0;
  def unest($ts): [$ts[] | select(.points == null)];
  def points_line($ts):
    total($ts) as $t
    | "\(plural($t; "point"; "points"))"
      + (if $hpp != null then " (\($t * $hpp | num) h)" else "" end)
      + (unest($ts) | if length > 0 then ", \(plural(length; "task"; "tasks")) not estimated" else "" end);

  plan_tasks as $all
| ([$milestones[]? | select(.state == "closed") | . as $m | sprint_info + {closed_at: $m.closed_at}
    | select(.velocity != null)] | sort_by(.closed_at // .end // "") | .[-3:]) as $recent
| [
    "<!-- Generated by `scrum plan render` from plan.json. Do not edit by hand: edit plan.json and render again. -->",
    "",
    "# \($plan.title)",
    "",
    "Sprint: \($plan.sprint | sprint_text)",
    "",
    (if $plan.epic != null then
       "## Epic: \($plan.epic.title) (\($plan.epic | issue_ref))", "",
       (if ($plan.epic.body // "") != "" then $plan.epic.body, "" else empty end)
     else empty end),

    (plan_features[] as $f
     | "## \($f.id): \($f.title) (\($f | issue_ref))", "",
       (if ($f.body // "") != "" then $f.body, "" else empty end),
       (if $hpp != null then "| ID | Task | Points | Hours | Depends on | Issue |", "|---|---|---|---|---|---|"
        else "| ID | Task | Points | Depends on | Issue |", "|---|---|---|---|---|" end),
       ($f.tasks[] as $t
        | "| \($t.id | cell) | \($t.title | cell) | \(pts($t.points))"
          + (if $hpp != null then " | \(hours($t.points) | if . == null then "–" else num end)" else "" end)
          + " | \(($t | deps) | if length == 0 then "–" else join(", ") end) | \($t | issue_ref) |"),
       "",
       "Total: \(points_line($f.tasks))",
       "",
       ($f.tasks[] as $t
        | select(($t.body // "") != "" or (($t.acceptance // []) | length) > 0 or (($t.subtasks // []) | length) > 0
                 or ($t | has("sprint")) or $t.bug == true or (($t.assignees // []) | length) > 0)
        | "### \($t.id): \($t.title)", "",
          (if ($t.body // "") != "" then $t.body, "" else empty end),
          ([ (if $t | has("sprint") then "Sprint: \($t.sprint | sprint_text)" else empty end),
             (if $t.bug == true then "Bug" else empty end),
             (if (($t.assignees // []) | length) > 0 then "Assignees: \($t.assignees | map("@" + ltrimstr("@")) | join(", "))" else empty end)
           ] | if length > 0 then (join(" · "), "") else empty end),
          (if (($t.acceptance // []) | length) > 0 then "Acceptance criteria:", "", ($t.acceptance[] | "- [ ] \(.)"), "" else empty end),
          (if (($t.subtasks // []) | length) > 0 then "Subtasks:", "", ($t.subtasks[] | "- [ ] \(.)"), "" else empty end))),

    (if (($plan.assumptions // []) | length) > 0 then "## Assumptions", "", ($plan.assumptions[] | "- \(.)"), "" else empty end),
    (if (($plan.out_of_scope // []) | length) > 0 then "## Out of scope", "", ($plan.out_of_scope[] | "- \(.)"), "" else empty end),

    "## Estimate",
    "",
    "| Feature | Tasks | Points | Not estimated\(if $hpp != null then " | Hours" else "" end) |",
    "|---|---|---|---\(if $hpp != null then "|---" else "" end)|",
    (plan_features[] as $f
     | "| \($f.id): \($f.title | cell) | \($f.tasks | length) | \(total($f.tasks)) | \(unest($f.tasks) | length)"
       + (if $hpp != null then " | \(total($f.tasks) * $hpp | num)" else "" end) + " |"),
    "| **Total** | \($all | length) | \(total($all)) | \(unest($all) | length)"
      + (if $hpp != null then " | \(total($all) * $hpp | num)" else "" end) + " |",
    "",
    "Total: \(points_line($all))."
      + (if (unest($all) | length) > 0 then " Not estimated: \(unest($all) | map(.id) | join(", "))." else "" end),
    (if $hpp != null then "Hours use \($hpp | num) h per point (planning.hours_per_point)." else empty end),
    (if ($recent | length) > 0 then
       ([$recent[].velocity] | add / length) as $avg
       | "Velocity: \($avg | num) points per sprint on average over the last \(plural($recent | length; "closed sprint"; "closed sprints")) ("
         + ($recent | map("\(.title): \(.velocity)") | join(", ")) + ")."
         + (if $avg > 0 then " Estimated \(plural((total($all) / $avg) | ceil; "sprint"; "sprints"))." else "" end)
     else empty end),
    "",
    "This view is a snapshot of the plan. After apply, GitHub holds the live status of each issue."
  ]
| join("\n")
