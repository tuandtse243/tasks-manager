{
  "version": 1,
  "timezone": "UTC",
  "sprint": {
    "length_days": 5,
    "name_pattern": "Sprint {n}"
  },
  "points": {
    "scale": [
      0,
      1,
      3,
      7
    ],
    "label_prefix": "points: "
  },
  "statuses": {
    "label_prefix": "status: ",
    "new": "New",
    "in_progress": "In progress",
    "done": "Done"
  },
  "labels": {
    "bug": "bug",
    "feature": "type: feature",
    "epic": "type: epic",
    "meta": "scrum: meta",
    "no_task": "no-task"
  },
  "branch": {
    "pattern": "feat/{number}-{slug}"
  },
  "digest": {
    "enabled": true,
    "cron": "0 1 * * 1-5"
  },
  "colors": {},
  "project": {
    "enabled": false,
    "owner": null,
    "number": null,
    "status_field": "Status",
    "status_options": {
      "new": "Todo",
      "in_progress": "In Progress",
      "done": "Done"
    },
    "synced_field": "Synced status",
    "points_field": "Points",
    "poll_cron": "*/15 * * * *"
  },
  "planning": {
    "dir": "docs/plans",
    "context_file": "docs/project-context.md",
    "hours_per_point": null,
    "context_stale_commits": 50
  }
}
