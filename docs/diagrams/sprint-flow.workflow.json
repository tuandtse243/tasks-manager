  "cards": [
    {
      "dot": "emerald",
      "title": "Đường chính",
      "items": [
        "plan đưa task vào backlog; sprint-fill chọn task vừa sức chứa",
        "Trạng thái đi theo PR; sửa task bằng lệnh task, không sửa label tay",
        "Merge PR có Closes #N là task Done"
      ]
    },
    {
      "dot": "rose",
      "title": "Khi bị chặn",
      "items": [
        "PR không gắn task thì check scrum-pr-link-check đỏ",
        "Lệnh báo lỗi: doctor; không biết làm gì tiếp: next"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cuối sprint",
      "items": [
        "sprint-report: burndown dựng từ lịch sử task",
        "sprint-close ghi velocity, chuyển task dở, đăng tổng kết"
      ]
    }
  ]
}
