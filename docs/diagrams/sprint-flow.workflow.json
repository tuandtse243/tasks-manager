    {
      "id": "report",
      "lane": "auto",
      "col": 5,
      "type": "database",
      "label": "Theo dõi",
      "sublabel": "report, digest"
    }
  ],
  "edges": [
    {
      "from": "init",
      "to": "sprint"
    },
    {
      "from": "sprint",
      "to": "plan"
    },
    {
      "from": "plan",
      "to": "start",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "start",
      "to": "pr"
    },
    {
      "from": "pr",
      "to": "merge"
    },
    {
      "from": "pr",
      "to": "inprog",
      "label": "mở PR",
      "role": "async",
      "variant": "dashed"
    },
    {
      "from": "merge",
      "to": "done",
      "variant": "emphasis"
    },
    {
      "from": "done",
      "to": "report",
      "role": "async",
      "variant": "dashed"
    },
    {
      "from": "done",
      "to": "close"
    }
