      "id": "sm",
      "label": "PO / Scrum Master"
    },
    {
      "id": "dev",
      "label": "Dev"
    },
    {
      "id": "auto",
      "label": "GitHub Actions (tự động)"
    }
  ],
  "phases": [
    {
      "id": "setup",
      "label": "Chuẩn bị",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "work",
      "label": "Trong sprint",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "end",
      "label": "Cuối sprint",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "init",
    "sprint",
    "plan",
    "start",
    "pr",
    "merge",
    "done",
    "close"
