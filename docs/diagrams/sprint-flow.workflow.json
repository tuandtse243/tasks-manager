{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "One sprint with scrum-github",
    "quality_profile": "showcase",
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [
      900,
      528
    ]
  },
  "lanes": [
    {
      "id": "sm",
      "label": "PO / Scrum Master"
    },
    {
      "id": "dev",
      "label": "Dev"
    },
    {
      "id": "auto",
      "label": "GitHub Actions (automatic)"
    }
  ],
  "phases": [
    {
      "id": "setup",
      "label": "Set up",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "work",
      "label": "During the sprint",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "end",
      "label": "End of sprint",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "init",
    "sprint",
    "plan",
    "start",
    "pr",
    "merge",
    "done",
    "close"
  ],
  "nodes": [
    {
      "id": "init",
      "lane": "sm",
      "col": 0,
      "type": "cloud",
      "label": "init",
      "sublabel": "then doctor"
    },
    {
      "id": "sprint",
      "lane": "sm",
      "col": 1,
      "type": "frontend",
      "label": "sprint-new",
      "sublabel": "milestone Sprint N"
    },
    {
      "id": "plan",
      "lane": "sm",
      "col": 2,
      "type": "frontend",
      "label": "sprint-fill",
      "sublabel": "backlog → sprint"
    },
    {
      "id": "close",
      "lane": "sm",
      "col": 5,
      "type": "frontend",
      "label": "sprint-close",
      "sublabel": "velocity + summary"
    },
    {
      "id": "start",
      "lane": "dev",
      "col": 2,
      "type": "backend",
      "label": "task-start",
      "sublabel": "branch feat/N-slug"
    },
    {
      "id": "pr",
      "lane": "dev",
      "col": 3,
      "type": "backend",
      "label": "task-pr",
      "sublabel": "PR with Closes #N"
    },
    {
      "id": "merge",
      "lane": "dev",
      "col": 4,
      "type": "backend",
      "label": "Merge PR",
      "sublabel": "after review"
    },
    {
      "id": "inprog",
      "lane": "auto",
      "col": 3,
      "type": "messagebus",
      "label": "In progress",
      "sublabel": "(In review if on)"
    },
    {
      "id": "done",
      "lane": "auto",
      "col": 4,
      "type": "messagebus",
      "label": "Done",
      "sublabel": "issue closes itself"
    },
    {
      "id": "report",
      "lane": "auto",
      "col": 5,
      "type": "database",
      "label": "Tracking",
      "sublabel": "report, digest"
    }
  ],
  "edges": [
    {
      "from": "init",
      "to": "sprint"
    },
    {
      "from": "sprint",
      "to": "plan"
    },
    {
      "from": "plan",
      "to": "start",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "start",
      "to": "pr"
    },
    {
      "from": "pr",
      "to": "merge"
    },
    {
      "from": "pr",
      "to": "inprog",
      "label": "open PR",
      "role": "async",
      "variant": "dashed"
    },
    {
      "from": "merge",
      "to": "done",
      "variant": "emphasis"
    },
    {
      "from": "done",
      "to": "report",
      "role": "async",
      "variant": "dashed"
    },
    {
      "from": "done",
      "to": "close"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "plan puts tasks in the backlog; sprint-fill picks what fits capacity",
        "Status follows the PR; change tasks with the task command, not labels",
        "Merging a PR with Closes #N makes the task Done"
      ]
    },
    {
      "dot": "rose",
      "title": "When blocked",
      "items": [
        "A PR with no linked task fails the scrum-pr-link-check",
        "A command fails: doctor; not sure what to do next: next"
      ]
    },
    {
      "dot": "cyan",
      "title": "End of sprint",
      "items": [
        "sprint-report: burndown rebuilt from task history",
        "sprint-close records velocity, moves unfinished tasks, posts a summary"
      ]
    }
  ]
}
