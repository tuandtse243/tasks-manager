  "nodes": [
    {
      "id": "init",
      "lane": "sm",
      "col": 0,
      "type": "cloud",
      "label": "init",
      "sublabel": "rồi doctor"
    },
    {
      "id": "sprint",
      "lane": "sm",
      "col": 1,
      "type": "frontend",
      "label": "sprint-new",
      "sublabel": "milestone Sprint N"
    },
    {
      "id": "plan",
      "lane": "sm",
      "col": 2,
      "type": "frontend",
      "label": "sprint-fill",
